<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="480.0" prefWidth="511.0" stylesheets="@../../CSS/estilos_inicio.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_gesellschaft.controler.InicioController">
   <children>
      <HBox id="cabecera" prefHeight="98.0" prefWidth="511.0">
         <children>
            <ImageView fitHeight="97.0" fitWidth="87.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Imagenes/faust_icon.png" />
               </image>
            </ImageView>
            <Label fx:id="Saludo" prefHeight="54.0" prefWidth="299.0" text="Faust actual: FaustLCB" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="20.0" left="10.0" top="20.0" />
               </HBox.margin>
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Button id="CerrarSesion" fx:id="btnLogout" mnemonicParsing="false" onAction="#cerrarSesion" prefHeight="38.0" prefWidth="109.0" text="🚪 Cerrar sesión" textFill="WHITE">
               <font>
                  <Font size="13.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="30.0" top="30.0" />
               </HBox.margin>
            </Button>
         </children></HBox>
      <TableView fx:id="tablaFausts" layoutX="38.0" layoutY="142.0" prefHeight="218.0" prefWidth="435.0">
        <columns>
          <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
          <TableColumn fx:id="colPermisos" prefWidth="75.0" text="Permisos" />
            <TableColumn fx:id="colLenguaje" prefWidth="75.0" text="Lenguaje" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="14.0" layoutY="108.0" prefHeight="22.0" prefWidth="120.0" text="Filtrar por lenguaje:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbFiltrado" layoutX="134.0" layoutY="106.0" onAction="#filtrar" prefWidth="150.0" />
      <HBox layoutX="14.0" layoutY="428.0" prefHeight="38.0" prefWidth="351.0">
         <children>
            <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="133.0" text="✎ Editar Faust">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Button fx:id="btnExcel" mnemonicParsing="false" onAction="#exportarExcel" prefHeight="38.0" prefWidth="69.0" text="Excel">
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Button fx:id="btnPDF" layoutX="153.0" layoutY="10.0" mnemonicParsing="false" onAction="#exportarPDF" prefHeight="38.0" prefWidth="69.0" text="PDF">
               <font>
                  <Font size="14.0" />
               </font>
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <ImageView fitHeight="125.0" fitWidth="171.0" layoutX="326.0" layoutY="366.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../Imagenes/Faust1000iq.jpg" />
         </image>
      </ImageView>
   </children>
</AnchorPane>

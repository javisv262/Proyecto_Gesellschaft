<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="435.0" prefWidth="464.0" stylesheets="@../../CSS/estilos_inicio.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_gesellschaft.controler.InicioController">
   <children>
      <HBox id="cabecera" prefHeight="89.0" prefWidth="464.0">
         <children>
            <ImageView fitHeight="97.0" fitWidth="87.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Imagenes/faust_icon.png" />
               </image>
            </ImageView>
            <Label fx:id="Saludo" prefHeight="53.0" prefWidth="162.0" text="Bienvenido" textFill="WHITE">
               <HBox.margin>
                  <Insets bottom="20.0" left="10.0" top="20.0" />
               </HBox.margin>
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Button id="CerrarSesion" fx:id="btnLogout" mnemonicParsing="false" onAction="#cerrarSesion" prefHeight="38.0" prefWidth="109.0" text="🚪 Cerrar sesión" textFill="WHITE">
               <font>
                  <Font size="13.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="30.0" left="80.0" top="30.0" />
               </HBox.margin>
            </Button>
         </children></HBox>
      <TableView fx:id="tablaFausts" layoutX="14.0" layoutY="144.0" prefHeight="218.0" prefWidth="435.0">
        <columns>
          <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
          <TableColumn fx:id="colPermisos" prefWidth="75.0" text="Permisos" />
            <TableColumn fx:id="colLenguaje" prefWidth="75.0" text="Lenguaje" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="14.0" layoutY="108.0" prefHeight="22.0" prefWidth="120.0" text="Filtrar por lenguaje:">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="cbFiltrado" layoutX="134.0" layoutY="106.0" prefWidth="150.0" />
   </children>
</AnchorPane>

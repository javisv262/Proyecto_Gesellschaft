<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="465.0" prefWidth="323.0" stylesheets="@../../CSS/estilos_registro.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_gesellschaft.controler.RegistroController">
   <children>
      <VBox layoutX="16.0" layoutY="96.0" prefHeight="264.0" prefWidth="289.0">
         <children>
            <HBox prefHeight="39.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="27.0" prefWidth="133.0" text="Usuario de Faust:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="txtNombreRegistro" onAction="#leerUsuario" prefHeight="29.0" prefWidth="149.0">
                     <HBox.margin>
                        <Insets left="5.0" top="3.0" />
                     </HBox.margin>
                  </TextField>
               </children></HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="39.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="27.0" prefWidth="133.0" text="Contraseña:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="txtPasswordRegistro" onAction="#leerPassword" prefHeight="29.0" prefWidth="149.0">
                     <HBox.margin>
                        <Insets left="5.0" top="3.0" />
                     </HBox.margin>
                  </TextField>
               </children>
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="81.0" prefWidth="250.0">
               <children>
                  <Label prefHeight="27.0" prefWidth="62.0" text="Permisos">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                  </Label>
                  <VBox prefHeight="81.0" prefWidth="142.0">
                     <children>
                        <RadioButton fx:id="rbAdmin" mnemonicParsing="false" text="Administrador" textFill="WHITE">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoPermisos" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbEstandar" mnemonicParsing="false" text="Estándar" textFill="WHITE" toggleGroup="$grupoPermisos">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </RadioButton>
                        <RadioButton fx:id="rbInferior" mnemonicParsing="false" text="Faust inferior" textFill="WHITE" toggleGroup="$grupoPermisos">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </RadioButton>
                     </children>
                     <HBox.margin>
                        <Insets left="85.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="56.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="46.0" prefWidth="133.0" text="Lenguaje de programacion:" wrapText="true">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="cbLenguajeRegistro" prefHeight="30.0" prefWidth="150.0">
                     <HBox.margin>
                        <Insets top="12.0" />
                     </HBox.margin>
                  </ComboBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox layoutX="18.0" layoutY="326.0" prefHeight="39.0" prefWidth="282.0">
         <children>
            <Button id="registrar" fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarProgramador" prefHeight="34.0" prefWidth="131.0" text="👤 Registrar">
               <font>
                  <Font size="15.0" />
               </font></Button>
            <Button fx:id="btnIrLogin" mnemonicParsing="false" onAction="#lanzarLogin" prefHeight="34.0" prefWidth="136.0" text="← Volver al Login">
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
         </children></HBox>
      <ImageView fitHeight="99.0" fitWidth="86.0" layoutX="120.0" layoutY="365.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../Imagenes/faustPlush.jpg" />
         </image>
      </ImageView>
      <HBox id="cabecera" prefHeight="56.0" prefWidth="323.0">
         <children>
            <ImageView fitHeight="73.0" fitWidth="82.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Imagenes/faust_icon.png" />
               </image>
            </ImageView>
            <Label prefHeight="38.0" prefWidth="250.0" text="👤 Registro de Faust">
               <font>
                  <Font name="System Bold" size="25.0" />
               </font>
               <HBox.margin>
                  <Insets top="16.0" />
               </HBox.margin>
            </Label>
         </children></HBox>
   </children>
</AnchorPane>

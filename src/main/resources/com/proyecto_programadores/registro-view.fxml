<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="465.0" prefWidth="323.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto_programadores.controler.RegistroController">
   <children>
      <Label layoutX="14.0" layoutY="30.0" prefHeight="38.0" prefWidth="250.0" text="👤 Registro de Usuario">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
      <VBox layoutX="16.0" layoutY="96.0" prefHeight="264.0" prefWidth="289.0">
         <children>
            <HBox prefHeight="39.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="27.0" prefWidth="133.0" text="Nombre de usuario:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="txtNombreRegistro" prefHeight="29.0" prefWidth="149.0">
                     <HBox.margin>
                        <Insets left="5.0" top="3.0" />
                     </HBox.margin>
                  </TextField>
               </children></HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="39.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="27.0" prefWidth="133.0" text="Contraseña:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="txtPasswordRegistro" prefHeight="29.0" prefWidth="149.0">
                     <HBox.margin>
                        <Insets left="5.0" top="3.0" />
                     </HBox.margin>
                  </TextField>
               </children>
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="81.0" prefWidth="250.0">
               <children>
                  <Label text="Género:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <padding>
                        <Insets top="5.0" />
                     </padding>
                  </Label>
                  <VBox prefHeight="81.0" prefWidth="142.0">
                     <children>
                        <RadioButton fx:id="rbHombre" mnemonicParsing="false" text="Hombre">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                           <toggleGroup>
                              <ToggleGroup fx:id="grupoGenero" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbMujer" mnemonicParsing="false" text="Mujer" toggleGroup="$grupoGenero">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </RadioButton>
                        <RadioButton fx:id="rbPrefieroNoDecirlo" mnemonicParsing="false" text="Prefiero no decirlo" toggleGroup="$grupoGenero">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </RadioButton>
                     </children>
                     <HBox.margin>
                        <Insets left="85.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="56.0" prefWidth="289.0">
               <children>
                  <Label prefHeight="46.0" prefWidth="133.0" text="Lenguaje de programacion:" wrapText="true">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="3.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="cbLenguajeRegistro" prefHeight="30.0" prefWidth="150.0">
                     <HBox.margin>
                        <Insets top="12.0" />
                     </HBox.margin>
                  </ComboBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <HBox layoutX="18.0" layoutY="326.0" prefHeight="39.0" prefWidth="282.0">
         <children>
            <Button id="registrar" fx:id="btnRegistrar" mnemonicParsing="false" prefHeight="34.0" prefWidth="131.0" stylesheets="@../../CSS/estilos_registro.css" text="👤 Registrar">
               <font>
                  <Font size="15.0" />
               </font></Button>
            <Button fx:id="btnIrLogin" mnemonicParsing="false" onAction="#lanzarLogin" prefHeight="34.0" prefWidth="136.0" text="← Volver al Login">
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
         </children></HBox>
   </children>
</AnchorPane>
